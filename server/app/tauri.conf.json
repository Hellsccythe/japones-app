{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Japones App",
  "version": "0.2.0",
  "identifier": "com.japonesapp.desktop",
  "build": {
    "frontendDist": "../../client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Japonês App",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Japonês App contributors",
    "copyright": "MIT OR Apache-2.0",
    "category": "Education",
    "shortDescription": "Frases de exemplo, furigana, áudio e revisão para estudar japonês",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}