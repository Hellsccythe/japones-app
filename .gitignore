*.keystore
keystore.properties

# Helper scripts: build output and model outputs.
scripts/**/target/
scripts/llm-eval/*.jsonl
scripts/llm-eval/results/

# Tauri CLI from npm
node_modules/

# Plan execution scratch (superpowers)
.superpowers/

# Visual C++ runtime copied by server/app/build.rs; ships in the installer only.
server/app/vcredist/
